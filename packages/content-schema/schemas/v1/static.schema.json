{
  "$id": "urn:learnlab:content:v1:static.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tools": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string",
                "const": "actionlint"
              },
              "files": {
                "minItems": 1,
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "ignore": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            },
            "required": [
              "tool",
              "files"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string",
                "const": "hadolint"
              },
              "files": {
                "minItems": 1,
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "threshold": {
                "type": "string",
                "enum": [
                  "error",
                  "warning",
                  "info",
                  "style"
                ]
              },
              "ignore": {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(DL|SC)\\d{4}$"
                }
              },
              "trusted-registries": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            },
            "required": [
              "tool",
              "files"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string",
                "const": "kubeconform"
              },
              "files": {
                "minItems": 1,
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "skip": {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Za-z0-9]*$"
                }
              }
            },
            "required": [
              "tool",
              "files"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string",
                "const": "conftest"
              },
              "files": {
                "minItems": 1,
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "namespace": {
                "type": "string",
                "pattern": "^[a-z_][a-z0-9_]*(?:\\.[a-z_][a-z0-9_]*)*$"
              },
              "parser": {
                "type": "string",
                "enum": [
                  "codeowners",
                  "cue",
                  "cyclonedx",
                  "dockerfile",
                  "dotenv",
                  "edn",
                  "groovy",
                  "hcl1",
                  "hcl2",
                  "hocon",
                  "ignore",
                  "ini",
                  "json",
                  "jsonnet",
                  "nginx",
                  "properties",
                  "spdx",
                  "textproto",
                  "toml",
                  "vcl",
                  "xml",
                  "yaml"
                ]
              },
              "combine": {
                "type": "boolean"
              },
              "rules": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,19}$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              }
            },
            "required": [
              "tool",
              "files",
              "rules"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "tools"
  ],
  "additionalProperties": false,
  "title": "Learn2K static checks of an exercise (static.yaml)"
}
