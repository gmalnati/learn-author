{
  "$id": "urn:learnlab:content:v1:cases.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "timeout": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "cases": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "args": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            }
          },
          "input": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "exit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "compare": {
            "type": "string",
            "enum": [
              "trimmed",
              "exact"
            ]
          }
        },
        "required": [
          "name",
          "output"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "cases"
  ],
  "additionalProperties": false,
  "title": "Learn2K input and output cases of an exercise (cases.yaml)"
}
